# Signs and ships Ma from a GitHub runner. Nobody needs a Mac.
#
# Certificates and profiles live encrypted in the match repo, created and
# refreshed through the App Store Connect API key.

default_platform(:ios)

APP_IDS = {
  "com.sensei.ma" => "Ma",
  "com.sensei.ma.shieldconfig" => "Ma Shield",
  "com.sensei.ma.shieldaction" => "Ma Action",
  "com.sensei.ma.monitor" => "Ma Monitor",
  "com.sensei.ma.filter" => "Ma Filter",
}.freeze

# The Safari extension never touches Screen Time, so it goes without.
FAMILY_CONTROLS_IDS = (APP_IDS.keys - ["com.sensei.ma.filter"]).freeze

def api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: "fastlane/.keys/AuthKey.p8",
    in_house: false
  )
end

def match_auth
  Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}")
end

def build_number
  (ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i).to_s
end

def profiles(kind)
  APP_IDS.keys.to_h { |id| [id, "match #{kind} #{id}"] }
end

platform :ios do
  desc "Creates missing bundle ids and switches on what the API can switch on"
  lane :bootstrap do
    api_key
    APP_IDS.each do |identifier, name|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier) ||
               Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
      have = bundle.get_capabilities.map(&:capability_type)
      wanted = ["APP_GROUPS"]
      wanted << "FAMILY_CONTROLS" if FAMILY_CONTROLS_IDS.include?(identifier)
      (wanted - have).each do |capability|
        begin
          bundle.create_capability(capability)
          UI.success("#{identifier}: #{capability} on")
        rescue StandardError => e
          UI.important("#{identifier}: #{capability} could not be switched on here (#{e.message}). Tick it in the developer portal, see docs/SETUP.md.")
        end
      end
    end
  end

  desc "Development build for your own iPhone. Works before Apple approves the Family Controls distribution entitlement."
  lane :device do
    setup_ci
    key = api_key
    bootstrap

    udid = ENV["DEVICE_UDID"].to_s.strip
    unless udid.empty?
      register_devices(devices: { (ENV["DEVICE_NAME"] || "iPhone") => udid }, api_key: key)
    end

    sync_code_signing(
      type: "development",
      app_identifier: APP_IDS.keys,
      api_key: key,
      readonly: false,
      force: true,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: match_auth
    )

    build_app(
      project: "Ma.xcodeproj",
      scheme: "Ma",
      configuration: "Release",
      export_method: "development",
      xcargs: "MA_PROFILE_KIND=Development MA_SIGN_IDENTITY='Apple Development' CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { provisioningProfiles: profiles("Development") },
      output_directory: "build",
      output_name: "Ma.ipa"
    )
  end

  desc "App Store build to TestFlight. Needs the approved Family Controls distribution entitlement."
  lane :beta do
    setup_ci
    key = api_key
    bootstrap

    sync_code_signing(
      type: "appstore",
      app_identifier: APP_IDS.keys,
      api_key: key,
      readonly: false,
      force: true,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: match_auth
    )

    build_app(
      project: "Ma.xcodeproj",
      scheme: "Ma",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { provisioningProfiles: profiles("AppStore") },
      output_directory: "build",
      output_name: "Ma.ipa"
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
